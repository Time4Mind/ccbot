[Unit]
Description=Restart ccbot after prolonged proxy unavailability
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=FAIL_AFTER_SEC=1800
EnvironmentFile=-/etc/ccbot-connectivity-watchdog.env
Environment=CHECK_URL=https://api.telegram.org/
Environment="CONTAINERS=ccbot ccbot2"
ExecStart=/usr/local/sbin/ccbot-connectivity-watchdog
TimeoutStartSec=60
