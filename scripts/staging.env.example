# Keep this file secret after copying it to ~/.ccbot-staging/.env.
TELEGRAM_BOT_TOKEN=
ALLOWED_USERS=

# Staging stays on Codex and has its own tmux and Codex homes.
CCBOT_AGENT_BACKEND=codex
TMUX_SESSION_NAME=ccbot-staging
CODEX_HOME=/Users/your-user/.codex-staging
CCBOT_CODEX_SESSIONS_PATH=/Users/your-user/.codex-staging/sessions

# Avoid automatic expiry while exercising restore/switch scenarios.
SESSION_IDLE_TTL=0
ARCHIVE_PURGE_AFTER=0
VOICE_BACKEND=off
